# E-mail transacional via Resend. Nunca envie esta chave para o frontend.
RESEND_API_KEY=re_xxxxxxxxx

# Use um remetente do domínio que estiver verificado no painel do Resend.
RESEND_FROM="CortaAí <contato@seudominio.com>"

# Caixa que recebe os chamados enviados pela área de suporte.
SUPORTE_EMAIL=suporte@seudominio.com

# URL pública do frontend, usada nos links de redefinição de senha.
FRONTEND_URL=https://cortaaibarberbook.pages.dev
