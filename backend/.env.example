# E-mail transacional via Resend. Nunca envie esta chave para o frontend.
RESEND_API_KEY=re_sua_chave_do_resend

# Use um remetente de domínio verificado no painel do Resend.
RESEND_FROM="CortaAí <contato@seu-dominio.com>"

# Caixa que recebe os chamados enviados pela área de suporte.
SUPORTE_EMAIL=suporte@seu-dominio.com

# URLs públicas da aplicação.
FRONTEND_URL=https://seu-site.pages.dev
BACKEND_URL=https://seu-backend.onrender.com

# Supabase Storage: bucket público para imagens persistentes.
# Use a Secret Key do painel do Supabase; nunca a exponha no frontend, no Git ou em mensagens.
SUPABASE_URL=https://seu-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_sua_chave_secreta
SUPABASE_STORAGE_BUCKET=barberbook-media

# @supabase/supabase-js requer Node 22 ou superior no backend/Render.
NODE_VERSION=22

# Mercado Pago: a chave pública é fornecida ao navegador pelo endpoint /api/pagamento/config.
# Nunca use o Access Token ou o segredo do webhook no frontend, no Git ou em mensagens.
MERCADO_PAGO_PUBLIC_KEY=APP_USR_sua_chave_publica
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_seu_access_token
MERCADO_PAGO_WEBHOOK_SECRET=seu_segredo_de_webhook
